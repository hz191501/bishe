# Configurazione di esempio per una nuova installazione locale.
# Copiare in .env e sostituire i segnaposto prima di avviare il progetto.
APP_ENV=dev
APP_SECRET=replace-with-a-random-local-secret
DATABASE_URL="mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/buddybridge?serverVersion=10.4.32-MariaDB&charset=utf8mb4"
MAILER_DSN=null://null
