

{# 通用分页组件：只有总页数大于 1 时才显示页码导航。 #}
{% if pagination.totalPages > 1 %}
    {% set pageParameter = page_param|default('page') %}
    {% set routeParameters = route_params|default({})|merge(app.request.query.all) %}
    <nav class="pagination-wrap" aria-label="Navigazione pagine">
        {# 显示“当前第几页 / 总共几页”。 #}
        <span class="pagination-summary">
            Pagina {{ pagination.currentPage }} di {{ pagination.totalPages }}
        </span>
        <ul class="pagination pagination-sm mb-0">
            {# 第一页时禁用上一页按钮；merge 会保留当前搜索和筛选条件。 #}
            <li class="page-item {{ pagination.currentPage == 1 ? 'disabled' : '' }}">
                <a
                    class="page-link"
                    href="{{ path(route_name, routeParameters|merge({(pageParameter): pagination.currentPage - 1})) }}"
                    aria-label="Pagina precedente"
                >
                    ←
                </a>
            </li>

            {# 最多显示当前页前后各两个页码，避免页数很多时导航过长。 #}
            {% set firstPage = max(1, pagination.currentPage - 2) %}
            {% set lastPage = min(pagination.totalPages, pagination.currentPage + 2) %}
            {% for pageNumber in firstPage..lastPage %}
                <li class="page-item {{ pageNumber == pagination.currentPage ? 'active' : '' }}">
                    <a class="page-link" href="{{ path(route_name, routeParameters|merge({(pageParameter): pageNumber})) }}">{{ pageNumber }}</a>
                </li>
            {% endfor %}

            {# 最后一页时禁用下一页按钮。 #}
            <li class="page-item {{ pagination.currentPage == pagination.totalPages ? 'disabled' : '' }}">
                <a
                    class="page-link"
                    href="{{ path(route_name, routeParameters|merge({(pageParameter): pagination.currentPage + 1})) }}"
                    aria-label="Pagina successiva"
                >
                    →
                </a>
            </li>
        </ul>
    </nav>
{% endif %}
