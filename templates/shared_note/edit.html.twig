{% extends 'base.html.twig' %}
{% block title %}Modifica nota | BuddyBridge{% endblock %}
{% block body %}
<div class="shared-note-page shared-note-page--narrow">
    <a class="note-back" href="{{ path('app_shared_note_show', {id: note.id}) }}">← Torna alla nota</a>
    <header class="note-page-heading"><span class="eyebrow">IL TUO APPUNTO</span><h1>Modifica la nota</h1><p>Puoi correggere il tuo testo. La risposta salvata e le aggiunte restano invariate.</p></header>
    <div class="note-editor-card">
        {% if error %}<div class="alert alert-warning" role="alert">{{ error }}</div>{% endif %}
        <form method="post" class="note-editor-form">
            <input type="hidden" name="_token" value="{{ csrf_token('edit_note_' ~ note.id) }}">
            {% include 'shared_note/_fields.html.twig' %}
            <div class="note-form-actions"><a class="btn btn-outline-secondary" href="{{ path('app_shared_note_show', {id: note.id}) }}">Annulla</a><button class="btn btn-primary" type="submit">Salva modifiche</button></div>
        </form>
    </div>
</div>
{% endblock %}
