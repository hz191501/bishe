

{# 修改密码页面：要求输入当前密码并确认新密码。 #}
{% extends 'base.html.twig' %}

{% block title %}Modifica password{% endblock %}

{% block body %}
    <div class="editor-page">
        <header class="compact-page-header">
            <div>
                <span class="eyebrow text-primary">SICUREZZA ACCOUNT</span>
                <h1>Modifica la password</h1>
                <p>Conferma la password attuale e scegline una nuova di almeno 8 caratteri.</p>
            </div>
            <a class="btn btn-outline-secondary" href="{{ path('app_profile_edit') }}">Torna al profilo</a>
        </header>

        <div class="editor-layout">
            <section class="editor-card">
                <div class="editor-card-heading">
                    <span>01</span>
                    <div>
                        <h2>Credenziali di accesso</h2>
                        <p>La nuova password verrà salvata in forma protetta.</p>
                    </div>
                </div>

                {{ form_start(form, {attr: {class: 'polished-form'}}) }}
                    {{ form_errors(form) }}
                    {{ form_row(form.currentPassword) }}
                    {{ form_row(form.newPassword.first) }}
                    {{ form_row(form.newPassword.second) }}

                    <div class="form-actions">
                        <a class="btn btn-outline-secondary" href="{{ path('app_profile_edit') }}">Annulla</a>
                        <button class="btn btn-primary" type="submit">Aggiorna password</button>
                    </div>
                {{ form_end(form) }}
            </section>

            <aside class="editor-aside">
                <div class="context-card tinted">
                    <h3>Una password più sicura</h3>
                    <p>Usa una combinazione personale e non riutilizzare la password di altri servizi.</p>
                </div>
            </aside>
        </div>
    </div>
{% endblock %}
